[
  {
    "name": "cio_list_campaigns",
    "description": "Return Customer.io lifecycle campaigns with IDs, names, state, trigger configuration, actions, tags, and timestamps. Answers which automations exist and whether they are running, drafted, or stopped.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Customer.io App API key"
        },
        "_region": {
          "type": "string",
          "enum": [
            "us",
            "eu"
          ],
          "description": "Workspace region; defaults to us"
        }
      },
      "required": [
        "_apiKey"
      ]
    }
  },
  {
    "name": "cio_campaign_metrics",
    "description": "Return time-bucketed Customer.io delivery, bounce, open, click, unsubscribe, and conversion metrics for one campaign. Answers how a lifecycle campaign performed and when engagement changed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Customer.io App API key"
        },
        "_region": {
          "type": "string",
          "enum": [
            "us",
            "eu"
          ],
          "description": "Workspace region; defaults to us"
        },
        "campaign_id": {
          "type": "number",
          "description": "Customer.io campaign ID"
        },
        "start": {
          "type": "number",
          "description": "Start as Unix seconds"
        },
        "end": {
          "type": "number",
          "description": "End as Unix seconds"
        },
        "resolution": {
          "type": "string",
          "enum": [
            "hourly",
            "daily",
            "weekly",
            "monthly"
          ],
          "description": "Metric bucket; defaults to daily"
        },
        "message_type": {
          "type": "string",
          "enum": [
            "email",
            "webhook",
            "twilio",
            "whatsapp",
            "slack",
            "push",
            "in_app",
            "live_notification"
          ]
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone such as America/Los_Angeles"
        }
      },
      "required": [
        "_apiKey",
        "campaign_id"
      ]
    }
  },
  {
    "name": "cio_list_segments",
    "description": "Return Customer.io audience segments with IDs, names, descriptions, dynamic or manual type, build progress, tags, and timestamps. Answers which audiences are available for targeting or analysis.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Customer.io App API key"
        },
        "_region": {
          "type": "string",
          "enum": [
            "us",
            "eu"
          ],
          "description": "Workspace region; defaults to us"
        }
      },
      "required": [
        "_apiKey"
      ]
    }
  },
  {
    "name": "cio_list_messages",
    "description": "Return a bounded page of Customer.io message deliveries with recipients, channel, campaign or newsletter parent, and delivery engagement timestamps. Answers which messages reached, bounced, opened, clicked, converted, or unsubscribed recipients.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_apiKey": {
          "type": "string",
          "description": "Customer.io App API key"
        },
        "_region": {
          "type": "string",
          "enum": [
            "us",
            "eu"
          ],
          "description": "Workspace region; defaults to us"
        },
        "limit": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum deliveries, default 50 and maximum 100"
        },
        "start": {
          "type": "string",
          "description": "Cursor from the previous response next field"
        },
        "metric": {
          "type": "string",
          "enum": [
            "attempted",
            "sent",
            "delivered",
            "opened",
            "clicked",
            "converted",
            "bounced",
            "spammed",
            "unsubscribed",
            "dropped",
            "failed",
            "undeliverable"
          ]
        },
        "message_type": {
          "type": "string",
          "enum": [
            "email",
            "webhook",
            "twilio",
            "whatsapp",
            "slack",
            "push",
            "in_app",
            "live_notification"
          ]
        },
        "campaign_id": {
          "type": "number"
        },
        "start_ts": {
          "type": "number",
          "description": "Delivery creation range start as Unix seconds"
        },
        "end_ts": {
          "type": "number",
          "description": "Delivery creation range end as Unix seconds"
        }
      },
      "required": [
        "_apiKey"
      ]
    }
  }
]
